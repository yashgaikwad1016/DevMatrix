generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  actor_id    BigInt?   @db.UnsignedBigInt
  project_id  BigInt?   @db.UnsignedBigInt
  action      String    @db.VarChar(120)
  entity_type String?   @db.VarChar(100)
  entity_id   BigInt?   @db.UnsignedBigInt
  description String?   @db.Text
  metadata    Json?
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
  users       users?    @relation(fields: [actor_id], references: [id], map: "fk_audit_actor")
  projects    projects? @relation(fields: [project_id], references: [id], map: "fk_audit_project")

  @@index([actor_id, created_at], map: "idx_audit_actor_created")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([project_id, created_at], map: "idx_audit_project_created")
}

model auth_accounts {
  id                      BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                 BigInt                 @db.UnsignedBigInt
  provider                auth_accounts_provider
  provider_account_id     String                 @db.VarChar(255)
  provider_email          String?                @db.VarChar(190)
  access_token_encrypted  String?                @db.Text
  refresh_token_encrypted String?                @db.Text
  token_expires_at        DateTime?              @db.DateTime(0)
  created_at              DateTime               @default(now()) @db.Timestamp(0)
  updated_at              DateTime               @default(now()) @db.Timestamp(0)
  users                   users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_auth_accounts_user")

  @@unique([provider, provider_account_id], map: "uq_auth_provider_account")
  @@index([user_id], map: "idx_auth_user_id")
}

model change_requests {
  id                                        BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  project_id                                BigInt                 @db.UnsignedBigInt
  requested_by                              BigInt                 @db.UnsignedBigInt
  title                                     String                 @db.VarChar(200)
  description                               String?                @db.Text
  estimated_cost                            Decimal                @default(0.00) @db.Decimal(12, 2)
  estimated_days                            Int                    @default(0)
  status                                    change_requests_status @default(submitted)
  approved_by                               BigInt?                @db.UnsignedBigInt
  approved_at                               DateTime?              @db.DateTime(0)
  completed_at                              DateTime?              @db.DateTime(0)
  created_at                                DateTime               @default(now()) @db.Timestamp(0)
  updated_at                                DateTime               @default(now()) @db.Timestamp(0)
  users_change_requests_approved_byTousers  users?                 @relation("change_requests_approved_byTousers", fields: [approved_by], references: [id], map: "fk_change_requests_approved_by")
  projects                                  projects               @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_change_requests_project")
  users_change_requests_requested_byTousers users                  @relation("change_requests_requested_byTousers", fields: [requested_by], references: [id], map: "fk_change_requests_requested_by")
  quotations                                quotations[]

  @@index([approved_by], map: "fk_change_requests_approved_by")
  @@index([requested_by], map: "fk_change_requests_requested_by")
  @@index([project_id], map: "idx_change_requests_project")
  @@index([status], map: "idx_change_requests_status")
}

model deliverables {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  project_id            BigInt            @db.UnsignedBigInt
  uploaded_by           BigInt?           @db.UnsignedBigInt
  name                  String            @db.VarChar(255)
  type                  deliverables_type
  storage_key           String            @db.VarChar(500)
  file_url              String?           @db.VarChar(1000)
  file_size             BigInt?           @db.UnsignedBigInt
  version               String?           @db.VarChar(50)
  is_final              Boolean           @default(false)
  requires_full_payment Boolean           @default(true)
  created_at            DateTime          @default(now()) @db.Timestamp(0)
  updated_at            DateTime          @default(now()) @db.Timestamp(0)
  projects              projects          @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_deliverables_project")
  users                 users?            @relation(fields: [uploaded_by], references: [id], map: "fk_deliverables_uploaded_by")

  @@index([uploaded_by], map: "fk_deliverables_uploaded_by")
  @@index([is_final], map: "idx_deliverables_final")
  @@index([project_id], map: "idx_deliverables_project")
}

model deployments {
  id                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  project_id          BigInt                  @db.UnsignedBigInt
  branch              String?                 @db.VarChar(120)
  commit_sha          String?                 @db.VarChar(100)
  environment         deployments_environment @default(staging)
  deployment_provider String?                 @db.VarChar(120)
  deployment_id       String?                 @db.VarChar(250)
  preview_url         String?                 @db.VarChar(1000)
  status              deployments_status      @default(queued)
  build_logs_url      String?                 @db.VarChar(1000)
  started_at          DateTime?               @db.DateTime(0)
  finished_at         DateTime?               @db.DateTime(0)
  created_at          DateTime                @default(now()) @db.Timestamp(0)
  projects            projects                @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_deployments_project")

  @@index([project_id], map: "idx_deployments_project")
  @@index([status], map: "idx_deployments_status")
}

model developer_profiles {
  id                  BigInt                                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id             BigInt                                 @unique(map: "user_id") @db.UnsignedBigInt
  bio                 String?                                @db.Text
  skills              Json?
  experience_years    Decimal?                               @db.Decimal(4, 1)
  availability_status developer_profiles_availability_status @default(available)
  timezone            String?                                @db.VarChar(100)
  created_at          DateTime                               @default(now()) @db.Timestamp(0)
  updated_at          DateTime                               @default(now()) @db.Timestamp(0)
  users               users                                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_developer_profile_user")
}

model email_verification_tokens {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @unique(map: "token_hash") @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_email_verify_user")

  @@index([user_id], map: "idx_email_verify_user")
}

model functional_requirements {
  id                     BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  project_requirement_id BigInt                           @db.UnsignedBigInt
  requirement_code       String?                          @db.VarChar(50)
  title                  String                           @db.VarChar(200)
  description            String?                          @db.Text
  priority               functional_requirements_priority @default(medium)
  acceptance_criteria    String?                          @db.Text
  created_at             DateTime                         @default(now()) @db.Timestamp(0)
  project_requirements   project_requirements             @relation(fields: [project_requirement_id], references: [id], onDelete: Cascade, map: "fk_functional_requirements_requirement")

  @@index([project_requirement_id], map: "idx_functional_requirements_requirement")
}

model github_integrations {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  project_id          BigInt    @unique(map: "project_id") @db.UnsignedBigInt
  installation_id     String?   @db.VarChar(150)
  repository_id       String?   @db.VarChar(100)
  repository_name     String?   @db.VarChar(200)
  repository_url      String?   @db.VarChar(1000)
  owner               String?   @db.VarChar(190)
  default_branch      String?   @db.VarChar(100)
  development_branch  String?   @db.VarChar(100)
  webhook_id          String?   @db.VarChar(150)
  last_commit_sha     String?   @db.VarChar(100)
  last_commit_message String?   @db.Text
  last_commit_author  String?   @db.VarChar(190)
  last_commit_at      DateTime? @db.DateTime(0)
  connected_by        BigInt?   @db.UnsignedBigInt
  connected_at        DateTime  @default(now()) @db.DateTime(0)
  updated_at          DateTime  @default(now()) @db.Timestamp(0)
  users               users?    @relation(fields: [connected_by], references: [id], map: "fk_github_connected_by")
  projects            projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_github_project")

  @@index([connected_by], map: "fk_github_connected_by")
}

model message_attachments {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  message_id  BigInt   @db.UnsignedBigInt
  file_name   String   @db.VarChar(255)
  storage_key String   @db.VarChar(500)
  file_url    String?  @db.VarChar(1000)
  file_type   String?  @db.VarChar(120)
  file_size   BigInt?  @db.UnsignedBigInt
  created_at  DateTime @default(now()) @db.Timestamp(0)
  messages    messages @relation(fields: [message_id], references: [id], onDelete: Cascade, map: "fk_message_attachments_message")

  @@index([message_id], map: "idx_message_attachments_message")
}

model messages {
  id                                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  project_id                        BigInt                @db.UnsignedBigInt
  sender_id                         BigInt                @db.UnsignedBigInt
  receiver_id                       BigInt?               @db.UnsignedBigInt
  message                           String                @db.Text
  is_read                           Boolean               @default(false)
  read_at                           DateTime?             @db.DateTime(0)
  created_at                        DateTime              @default(now()) @db.Timestamp(0)
  message_attachments               message_attachments[]
  projects                          projects              @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_messages_project")
  users_messages_receiver_idTousers users?                @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], map: "fk_messages_receiver")
  users_messages_sender_idTousers   users                 @relation("messages_sender_idTousers", fields: [sender_id], references: [id], map: "fk_messages_sender")

  @@index([sender_id], map: "fk_messages_sender")
  @@index([project_id, created_at], map: "idx_messages_project_created")
  @@index([receiver_id, is_read], map: "idx_messages_receiver_read")
}

model notifications {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  project_id BigInt?   @db.UnsignedBigInt
  type       String    @db.VarChar(100)
  title      String    @db.VarChar(220)
  message    String    @db.Text
  action_url String?   @db.VarChar(1000)
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  projects   projects? @relation(fields: [project_id], references: [id], map: "fk_notifications_project")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([project_id], map: "idx_notifications_project")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model password_reset_tokens {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @unique(map: "token_hash") @db.VarChar(255)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_password_reset_user")

  @@index([user_id], map: "idx_password_reset_user")
}

model payment_webhook_events {
  id            BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  provider      payment_webhook_events_provider @default(razorpay)
  event_id      String                          @unique(map: "event_id") @db.VarChar(190)
  event_type    String                          @db.VarChar(120)
  payload       Json
  signature     String?                         @db.VarChar(255)
  status        payment_webhook_events_status   @default(received)
  processed_at  DateTime?                       @db.DateTime(0)
  error_message String?                         @db.Text
  created_at    DateTime                        @default(now()) @db.Timestamp(0)

  @@index([status], map: "idx_webhook_status")
  @@index([event_type], map: "idx_webhook_type")
}

model payments {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  project_id          BigInt                @db.UnsignedBigInt
  client_id           BigInt                @db.UnsignedBigInt
  quotation_id        BigInt?               @db.UnsignedBigInt
  payment_number      String                @unique(map: "payment_number") @db.VarChar(60)
  payment_type        payments_payment_type
  amount              Decimal               @db.Decimal(12, 2)
  currency            String                @default("INR") @db.VarChar(10)
  razorpay_order_id   String?               @unique(map: "razorpay_order_id") @db.VarChar(150)
  razorpay_payment_id String?               @unique(map: "razorpay_payment_id") @db.VarChar(150)
  razorpay_signature  String?               @db.VarChar(255)
  status              payments_status       @default(created)
  failure_reason      String?               @db.Text
  paid_at             DateTime?             @db.DateTime(0)
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  users               users                 @relation(fields: [client_id], references: [id], map: "fk_payments_client")
  projects            projects              @relation(fields: [project_id], references: [id], map: "fk_payments_project")
  quotations          quotations?           @relation(fields: [quotation_id], references: [id], map: "fk_payments_quotation")
  receipts            receipts?

  @@index([client_id], map: "idx_payments_client")
  @@index([project_id], map: "idx_payments_project")
  @@index([quotation_id], map: "idx_payments_quotation")
  @@index([status], map: "idx_payments_status")
  @@index([payment_type], map: "idx_payments_type")
}

model project_ai_features {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  project_requirement_id BigInt               @db.UnsignedBigInt
  feature_name           String               @db.VarChar(180)
  description            String?              @db.Text
  is_required            Boolean              @default(true)
  created_at             DateTime             @default(now()) @db.Timestamp(0)
  project_requirements   project_requirements @relation(fields: [project_requirement_id], references: [id], onDelete: Cascade, map: "fk_ai_features_requirement")

  @@index([project_requirement_id], map: "idx_ai_features_requirement")
}

model project_designs {
  id                     BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  project_requirement_id BigInt                        @unique(map: "project_requirement_id") @db.UnsignedBigInt
  font_family            String?                       @db.VarChar(120)
  primary_color          String?                       @db.VarChar(20)
  secondary_color        String?                       @db.VarChar(20)
  accent_color           String?                       @db.VarChar(20)
  background_color       String?                       @db.VarChar(20)
  text_color             String?                       @db.VarChar(20)
  design_style           project_designs_design_style?
  reference_url          String?                       @db.VarChar(500)
  custom_instructions    String?                       @db.Text
  created_at             DateTime                      @default(now()) @db.Timestamp(0)
  updated_at             DateTime                      @default(now()) @db.Timestamp(0)
  project_requirements   project_requirements          @relation(fields: [project_requirement_id], references: [id], onDelete: Cascade, map: "fk_project_designs_requirement")
}

model project_files {
  id          BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  project_id  BigInt                 @db.UnsignedBigInt
  uploaded_by BigInt?                @db.UnsignedBigInt
  name        String                 @db.VarChar(255)
  storage_key String                 @db.VarChar(500)
  file_url    String?                @db.VarChar(1000)
  file_type   String?                @db.VarChar(120)
  file_size   BigInt?                @db.UnsignedBigInt
  category    project_files_category @default(other)
  created_at  DateTime               @default(now()) @db.Timestamp(0)
  projects    projects               @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_project_files_project")
  users       users?                 @relation(fields: [uploaded_by], references: [id], map: "fk_project_files_uploaded_by")

  @@index([uploaded_by], map: "fk_project_files_uploaded_by")
  @@index([category], map: "idx_project_files_category")
  @@index([project_id], map: "idx_project_files_project")
}

model project_members {
  id                                      BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  project_id                              BigInt                      @db.UnsignedBigInt
  user_id                                 BigInt                      @db.UnsignedBigInt
  member_role                             project_members_member_role @default(member)
  status                                  project_members_status      @default(invited)
  invited_by                              BigInt?                     @db.UnsignedBigInt
  joined_at                               DateTime?                   @db.DateTime(0)
  created_at                              DateTime                    @default(now()) @db.Timestamp(0)
  users_project_members_invited_byTousers users?                      @relation("project_members_invited_byTousers", fields: [invited_by], references: [id], map: "fk_project_members_invited_by")
  projects                                projects                    @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_project_members_project")
  users_project_members_user_idTousers    users                       @relation("project_members_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, map: "fk_project_members_user")

  @@unique([project_id, user_id], map: "uq_project_member")
  @@index([invited_by], map: "fk_project_members_invited_by")
  @@index([user_id], map: "idx_project_members_user")
}

model project_milestones {
  id            BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  project_id    BigInt                    @db.UnsignedBigInt
  milestone_key String                    @db.VarChar(60)
  name          String                    @db.VarChar(150)
  sequence_no   Int
  status        project_milestones_status @default(pending)
  progress      Int                       @default(0) @db.UnsignedTinyInt
  planned_start DateTime?                 @db.Date
  planned_end   DateTime?                 @db.Date
  actual_start  DateTime?                 @db.Date
  actual_end    DateTime?                 @db.Date
  created_at    DateTime                  @default(now()) @db.Timestamp(0)
  updated_at    DateTime                  @default(now()) @db.Timestamp(0)
  projects      projects                  @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_milestones_project")
  tasks         tasks[]

  @@unique([project_id, milestone_key], map: "uq_milestone_key")
  @@unique([project_id, sequence_no], map: "uq_milestone_sequence")
  @@index([project_id], map: "idx_milestones_project")
}

model project_requirements {
  id                                             BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  project_id                                     BigInt                      @db.UnsignedBigInt
  version                                        Int                         @default(1)
  description                                    String?                     @db.Text
  client_deadline                                DateTime?                   @db.Date
  additional_requirements                        String?                     @db.Text
  client_wants_tech_recommendation               Boolean                     @default(false)
  status                                         project_requirements_status @default(draft)
  submitted_by                                   BigInt?                     @db.UnsignedBigInt
  approved_by                                    BigInt?                     @db.UnsignedBigInt
  submitted_at                                   DateTime?                   @db.DateTime(0)
  approved_at                                    DateTime?                   @db.DateTime(0)
  created_at                                     DateTime                    @default(now()) @db.Timestamp(0)
  functional_requirements                        functional_requirements[]
  project_ai_features                            project_ai_features[]
  project_designs                                project_designs?
  users_project_requirements_approved_byTousers  users?                      @relation("project_requirements_approved_byTousers", fields: [approved_by], references: [id], map: "fk_requirements_approved_by")
  projects                                       projects                    @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_requirements_project")
  users_project_requirements_submitted_byTousers users?                      @relation("project_requirements_submitted_byTousers", fields: [submitted_by], references: [id], map: "fk_requirements_submitted_by")
  project_technologies                           project_technologies[]

  @@unique([project_id, version], map: "uq_requirement_version")
  @@index([approved_by], map: "fk_requirements_approved_by")
  @@index([submitted_by], map: "fk_requirements_submitted_by")
  @@index([project_id], map: "idx_requirements_project")
  @@index([status], map: "idx_requirements_status")
}

model project_reviews {
  id          BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  project_id  BigInt                      @db.UnsignedBigInt
  reviewer_id BigInt                      @db.UnsignedBigInt
  review_type project_reviews_review_type
  decision    project_reviews_decision
  comments    String?                     @db.Text
  created_at  DateTime                    @default(now()) @db.Timestamp(0)
  projects    projects                    @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_project_reviews_project")
  users       users                       @relation(fields: [reviewer_id], references: [id], map: "fk_project_reviews_reviewer")

  @@index([reviewer_id], map: "fk_project_reviews_reviewer")
  @@index([project_id], map: "idx_project_reviews_project")
}

model project_technologies {
  id                     BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  project_requirement_id BigInt                        @db.UnsignedBigInt
  category               project_technologies_category
  technology_name        String                        @db.VarChar(120)
  is_client_requested    Boolean                       @default(true)
  recommendation_note    String?                       @db.Text
  created_at             DateTime                      @default(now()) @db.Timestamp(0)
  project_requirements   project_requirements          @relation(fields: [project_requirement_id], references: [id], onDelete: Cascade, map: "fk_project_technologies_requirement")

  @@index([project_requirement_id], map: "idx_technologies_requirement")
}

model projects {
  id                                          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  project_number                              String                  @unique(map: "project_number") @db.VarChar(50)
  client_id                                   BigInt                  @db.UnsignedBigInt
  project_name                                String                  @db.VarChar(200)
  short_description                           String?                 @db.Text
  domain                                      String?                 @db.VarChar(120)
  project_type                                projects_project_type?
  priority                                    projects_priority       @default(normal)
  status                                      projects_status         @default(draft)
  deadline                                    DateTime?               @db.Date
  assigned_developer_id                       BigInt?                 @db.UnsignedBigInt
  total_amount                                Decimal                 @default(0.00) @db.Decimal(12, 2)
  advance_amount                              Decimal                 @default(0.00) @db.Decimal(12, 2)
  remaining_amount                            Decimal                 @default(0.00) @db.Decimal(12, 2)
  total_paid                                  Decimal                 @default(0.00) @db.Decimal(12, 2)
  payment_status                              projects_payment_status @default(unpaid)
  progress                                    Int                     @default(0) @db.UnsignedTinyInt
  started_at                                  DateTime?               @db.DateTime(0)
  completed_at                                DateTime?               @db.DateTime(0)
  delivered_at                                DateTime?               @db.DateTime(0)
  created_at                                  DateTime                @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime                @default(now()) @db.Timestamp(0)
  audit_logs                                  audit_logs[]
  change_requests                             change_requests[]
  deliverables                                deliverables[]
  deployments                                 deployments[]
  github_integrations                         github_integrations?
  messages                                    messages[]
  notifications                               notifications[]
  payments                                    payments[]
  project_files                               project_files[]
  project_members                             project_members[]
  project_milestones                          project_milestones[]
  project_requirements                        project_requirements[]
  project_reviews                             project_reviews[]
  users_projects_client_idTousers             users                   @relation("projects_client_idTousers", fields: [client_id], references: [id], map: "fk_projects_client")
  users_projects_assigned_developer_idTousers users?                  @relation("projects_assigned_developer_idTousers", fields: [assigned_developer_id], references: [id], map: "fk_projects_developer")
  quotations                                  quotations[]
  referrals                                   referrals[]
  tasks                                       tasks[]

  @@index([client_id], map: "idx_projects_client")
  @@index([created_at], map: "idx_projects_created_at")
  @@index([deadline], map: "idx_projects_deadline")
  @@index([assigned_developer_id], map: "idx_projects_developer")
  @@index([status], map: "idx_projects_status")
}

model quotation_items {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  quotation_id BigInt     @db.UnsignedBigInt
  item_name    String     @db.VarChar(200)
  description  String?    @db.Text
  quantity     Decimal    @default(1.00) @db.Decimal(10, 2)
  unit_price   Decimal    @default(0.00) @db.Decimal(12, 2)
  amount       Decimal    @default(0.00) @db.Decimal(12, 2)
  sort_order   Int        @default(0)
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  quotations   quotations @relation(fields: [quotation_id], references: [id], onDelete: Cascade, map: "fk_quotation_items_quotation")

  @@index([quotation_id], map: "idx_quotation_items_quotation")
}

model quotations {
  id                                  BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  project_id                          BigInt                    @db.UnsignedBigInt
  quotation_number                    String                    @unique(map: "quotation_number") @db.VarChar(60)
  quotation_type                      quotations_quotation_type @default(initial)
  parent_quotation_id                 BigInt?                   @db.UnsignedBigInt
  change_request_id                   BigInt?                   @db.UnsignedBigInt
  subtotal                            Decimal                   @default(0.00) @db.Decimal(12, 2)
  discount                            Decimal                   @default(0.00) @db.Decimal(12, 2)
  referral_discount                   Decimal                   @default(0.00) @db.Decimal(12, 2)
  urgent_fee                          Decimal                   @default(0.00) @db.Decimal(12, 2)
  tax                                 Decimal                   @default(0.00) @db.Decimal(12, 2)
  total_amount                        Decimal                   @default(0.00) @db.Decimal(12, 2)
  advance_percentage                  Decimal                   @default(40.00) @db.Decimal(5, 2)
  advance_amount                      Decimal                   @default(0.00) @db.Decimal(12, 2)
  remaining_amount                    Decimal                   @default(0.00) @db.Decimal(12, 2)
  currency                            String                    @default("INR") @db.VarChar(10)
  valid_until                         DateTime?                 @db.Date
  notes                               String?                   @db.Text
  terms                               String?                   @db.Text
  status                              quotations_status         @default(draft)
  created_by                          BigInt                    @db.UnsignedBigInt
  accepted_by                         BigInt?                   @db.UnsignedBigInt
  accepted_at                         DateTime?                 @db.DateTime(0)
  created_at                          DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                          DateTime                  @default(now()) @db.Timestamp(0)
  payments                            payments[]
  quotation_items                     quotation_items[]
  users_quotations_accepted_byTousers users?                    @relation("quotations_accepted_byTousers", fields: [accepted_by], references: [id], map: "fk_quotations_accepted_by")
  change_requests                     change_requests?          @relation(fields: [change_request_id], references: [id], map: "fk_quotations_change_request")
  users_quotations_created_byTousers  users                     @relation("quotations_created_byTousers", fields: [created_by], references: [id], map: "fk_quotations_created_by")
  quotations                          quotations?               @relation("quotationsToquotations", fields: [parent_quotation_id], references: [id], map: "fk_quotations_parent")
  other_quotations                    quotations[]              @relation("quotationsToquotations")
  projects                            projects                  @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_quotations_project")

  @@index([accepted_by], map: "fk_quotations_accepted_by")
  @@index([change_request_id], map: "fk_quotations_change_request")
  @@index([created_by], map: "fk_quotations_created_by")
  @@index([parent_quotation_id], map: "fk_quotations_parent")
  @@index([project_id], map: "idx_quotations_project")
  @@index([status], map: "idx_quotations_status")
}

model receipts {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  payment_id     BigInt                @unique(map: "payment_id") @db.UnsignedBigInt
  receipt_number String                @unique(map: "receipt_number") @db.VarChar(80)
  receipt_type   receipts_receipt_type
  amount         Decimal               @db.Decimal(12, 2)
  file_url       String?               @db.VarChar(1000)
  storage_key    String?               @db.VarChar(500)
  issued_at      DateTime              @default(now()) @db.DateTime(0)
  created_at     DateTime              @default(now()) @db.Timestamp(0)
  payments       payments              @relation(fields: [payment_id], references: [id], onDelete: Cascade, map: "fk_receipts_payment")
}

model referral_settings {
  id                     BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  enabled                Boolean                         @default(true)
  discount_type          referral_settings_discount_type @default(percentage)
  discount_value         Decimal                         @default(0.00) @db.Decimal(12, 2)
  maximum_discount       Decimal?                        @db.Decimal(12, 2)
  minimum_project_amount Decimal                         @default(0.00) @db.Decimal(12, 2)
  updated_by             BigInt?                         @db.UnsignedBigInt
  created_at             DateTime                        @default(now()) @db.Timestamp(0)
  updated_at             DateTime                        @default(now()) @db.Timestamp(0)
  users                  users?                          @relation(fields: [updated_by], references: [id], map: "fk_referral_settings_updated_by")

  @@index([updated_by], map: "fk_referral_settings_updated_by")
}

model referrals {
  id                                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  referrer_id                             BigInt                   @db.UnsignedBigInt
  referred_user_id                        BigInt                   @db.UnsignedBigInt
  referral_code                           String                   @db.VarChar(50)
  project_id                              BigInt?                  @db.UnsignedBigInt
  discount_type                           referrals_discount_type?
  discount_value                          Decimal?                 @db.Decimal(12, 2)
  discount_amount                         Decimal?                 @default(0.00) @db.Decimal(12, 2)
  status                                  referrals_status         @default(registered)
  rewarded_at                             DateTime?                @db.DateTime(0)
  created_at                              DateTime                 @default(now()) @db.Timestamp(0)
  projects                                projects?                @relation(fields: [project_id], references: [id], map: "fk_referrals_project")
  users_referrals_referred_user_idTousers users                    @relation("referrals_referred_user_idTousers", fields: [referred_user_id], references: [id], map: "fk_referrals_referred_user")
  users_referrals_referrer_idTousers      users                    @relation("referrals_referrer_idTousers", fields: [referrer_id], references: [id], map: "fk_referrals_referrer")

  @@unique([referrer_id, referred_user_id], map: "uq_referral_pair")
  @@index([referred_user_id], map: "fk_referrals_referred_user")
  @@index([project_id], map: "idx_referrals_project")
  @@index([status], map: "idx_referrals_status")
}

model system_settings {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  setting_key   String   @unique(map: "setting_key") @db.VarChar(120)
  setting_value Json
  updated_by    BigInt?  @db.UnsignedBigInt
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  users         users?   @relation(fields: [updated_by], references: [id], map: "fk_system_settings_updated_by")

  @@index([updated_by], map: "fk_system_settings_updated_by")
}

model tasks {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  project_id         BigInt              @db.UnsignedBigInt
  milestone_id       BigInt?             @db.UnsignedBigInt
  title              String              @db.VarChar(200)
  description        String?             @db.Text
  assigned_to        BigInt?             @db.UnsignedBigInt
  status             tasks_status        @default(todo)
  priority           tasks_priority      @default(medium)
  estimated_hours    Decimal?            @db.Decimal(7, 2)
  actual_hours       Decimal?            @db.Decimal(7, 2)
  due_date           DateTime?           @db.Date
  completed_at       DateTime?           @db.DateTime(0)
  created_at         DateTime            @default(now()) @db.Timestamp(0)
  updated_at         DateTime            @default(now()) @db.Timestamp(0)
  users              users?              @relation(fields: [assigned_to], references: [id], map: "fk_tasks_assigned_to")
  project_milestones project_milestones? @relation(fields: [milestone_id], references: [id], map: "fk_tasks_milestone")
  projects           projects            @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_tasks_project")

  @@index([assigned_to], map: "idx_tasks_assigned_to")
  @@index([milestone_id], map: "idx_tasks_milestone")
  @@index([project_id], map: "idx_tasks_project")
  @@index([status], map: "idx_tasks_status")
}

model user_sessions {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            BigInt    @db.UnsignedBigInt
  refresh_token_hash String    @unique(map: "refresh_token_hash") @db.VarChar(255)
  user_agent         String?   @db.VarChar(500)
  ip_address         String?   @db.VarChar(45)
  expires_at         DateTime  @db.DateTime(0)
  revoked_at         DateTime? @db.DateTime(0)
  created_at         DateTime  @default(now()) @db.Timestamp(0)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_sessions_user")

  @@index([expires_at], map: "idx_sessions_expires")
  @@index([user_id], map: "idx_sessions_user")
}

model users {
  id                                                            BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  name                                                          String                      @db.VarChar(120)
  email                                                         String                      @unique(map: "email") @db.VarChar(190)
