  referral_code                                                 String?                     @unique(map: "referral_code") @db.VarChar(50)
  referred_by                                                   BigInt?                     @db.UnsignedBigInt
  is_email_verified                                             Boolean                     @default(false)
  is_active                                                     Boolean                     @default(true)
  last_login_at                                                 DateTime?                   @db.DateTime(0)
  created_at                                                    DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                                                    DateTime                    @default(now()) @db.Timestamp(0)
  audit_logs                                                    audit_logs[]
  auth_accounts                                                 auth_accounts[]
  change_requests_change_requests_approved_byTousers            change_requests[]           @relation("change_requests_approved_byTousers")
  change_requests_change_requests_requested_byTousers           change_requests[]           @relation("change_requests_requested_byTousers")
  deliverables                                                  deliverables[]
  developer_profiles                                            developer_profiles?
  email_verification_tokens                                     email_verification_tokens[]
  github_integrations                                           github_integrations[]
  messages_messages_receiver_idTousers                          messages[]                  @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers                            messages[]                  @relation("messages_sender_idTousers")
  notifications                                                 notifications[]
  password_reset_tokens                                         password_reset_tokens[]
  payments                                                      payments[]
  project_files                                                 project_files[]
  project_members_project_members_invited_byTousers             project_members[]           @relation("project_members_invited_byTousers")
  project_members_project_members_user_idTousers                project_members[]           @relation("project_members_user_idTousers")
  project_requirements_project_requirements_approved_byTousers  project_requirements[]      @relation("project_requirements_approved_byTousers")
  project_requirements_project_requirements_submitted_byTousers project_requirements[]      @relation("project_requirements_submitted_byTousers")
  project_reviews                                               project_reviews[]
  projects_projects_client_idTousers                            projects[]                  @relation("projects_client_idTousers")
  projects_projects_assigned_developer_idTousers                projects[]                  @relation("projects_assigned_developer_idTousers")
  quotations_quotations_accepted_byTousers                      quotations[]                @relation("quotations_accepted_byTousers")
  quotations_quotations_created_byTousers                       quotations[]                @relation("quotations_created_byTousers")
  referral_settings                                             referral_settings[]
  referrals_referrals_referred_user_idTousers                   referrals[]                 @relation("referrals_referred_user_idTousers")
  referrals_referrals_referrer_idTousers                        referrals[]                 @relation("referrals_referrer_idTousers")
  system_settings                                               system_settings[]
  tasks                                                         tasks[]
  user_sessions                                                 user_sessions[]
  users                                                         users?                      @relation("usersTousers", fields: [referred_by], references: [id], map: "fk_users_referred_by")
  other_users                                                   users[]                     @relation("usersTousers")

  @@index([referred_by], map: "fk_users_referred_by")
  @@index([is_active], map: "idx_users_active")
  @@index([role], map: "idx_users_role")
}

